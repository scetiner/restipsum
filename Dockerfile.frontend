# Build stage
FROM node:18-alpine as builder
WORKDIR /app
COPY frontends/rest-ipsum/package.json ./package.json
COPY frontends/rest-ipsum/yarn.lock ./yarn.lock
RUN yarn install
COPY frontends/rest-ipsum/ .
RUN yarn build

# Production stage
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080 